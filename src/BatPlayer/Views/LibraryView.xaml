<UserControl x:Class="BatPlayer.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:BatPlayer.Converters"
              xmlns:loc="clr-namespace:BatPlayer.Localization"
             xmlns:controls="clr-namespace:BatPlayer.Controls"
            >
    <UserControl.Resources>
        <cv:TimeSpanToStringConverter x:Key="TimeStr"/>
        <cv:FileSizeToStringConverter x:Key="SizeStr"/>
        <cv:PathToImageConverter x:Key="Path2Img"/>
        <cv:NullToVisibilityConverter x:Key="Null2Vis"/>
        <cv:IntToVisibilityConverter x:Key="Int2Vis"/>
        <cv:InverseIntToVisibilityConverter x:Key="InverseInt2Vis"/>
        <cv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <cv:SnapToRowsConverter x:Key="SnapRows"/>
        <!-- True when the card is the currently playing track (Play/Pause switch) -->
        <cv:CurrentTrackPlayingConverter x:Key="IsCurrentTrackPlaying"/>
        <!-- Platform badge: the track's Source matches the parameter -->
        <cv:StringEqualsToVisibilityConverter x:Key="PlatformSource2Vis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="PageHeader" Grid.Row="0" Margin="32,14,24,8" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock FontSize="12" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding Tracks.Count, Mode=OneWay}"/>
                    <Run Text="{Binding [TracksInLibrary], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            
        <Button Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                    Command="{Binding ShuffleTracksCommand}"
                    ToolTip="{Binding [Shuffle], Source={x:Static loc:Loc.T}}">
                <Path Width="16" Height="16" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="{StaticResource IconShuffle}"/>
            </Button>
</Grid>

        <!-- Scan progress -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                Margin="24,0,24,12" Padding="14,10" CornerRadius="8"
                Visibility="{Binding IsScanning, Converter={StaticResource Bool2Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="{Binding [Scanning], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                        <Run Text="{Binding ScanProgress, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding ScanTotal, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ScanCurrentFile}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ProgressBar Grid.Column="1" Style="{StaticResource ProgressBarSlim}"
                             Width="200" Minimum="0" Maximum="{Binding ScanTotal, Mode=OneWay}"
                             Value="{Binding ScanProgress, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- Track cards: SoundCloud-like grid — 4 per row, large cover, title and artist below -->
        <Grid Grid.Row="2" x:Name="ListArea" Margin="24,0,16,4">
            <ListView controls:ScrollHeaderCollapse.Header="{Binding ElementName=PageHeader}" ScrollViewer.CanContentScroll="True" Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding Tracks}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VerticalContentAlignment="Stretch">
                <!-- The list is collapsed while loading: virtualization does not generate
                     containers for old cards, and clicking a bar avoids triple work
                     (create old → clear → create new) — a lag-free transition.
                     No skeleton or fade: a clean appearance once ready. -->
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- Square cover (1:1) across the full card width.
                                 SquareBorder: square already at measure — no double
                                 layout pass from a self-binding Height=ActualWidth. -->
                            <controls:SquareBorder x:Name="CoverRoot" CornerRadius="8"
                                    Background="{DynamicResource SecondaryBrush}">
                                <Grid>
                                    <!-- No cover: gray bat silhouette — the shared placeholder
                                         of all bars (CardBatPlaceholder, no rotation) -->
                                    <Image Style="{StaticResource CardBatPlaceholder}"/>
                                    <!-- Cover. LazyCover: background decode in batches of 8; while scrolling only visible items load -->
                                    <Border CornerRadius="8" controls:LazyCover.Path="{Binding CoverCachePath}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=(controls:LazyCover.HasImage), RelativeSource={RelativeSource Self}}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.3"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>

                                    <!-- Translucent white overlay: on hover OR while this track plays.
                                         Fade in/out 0.15s, as on the platform pages. -->
                                    <Border x:Name="CoverHoverOverlay" CornerRadius="8"
                                            Background="#40FFFFFF" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CoverRoot}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource IsCurrentTrackPlaying}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.Player.CurrentTrack" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <!-- ExitActions is required: without it the Enter animation stuck at
                                                             opacity=1 on track change / list rebuild (multiple overlays). -->
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Central Play button (~32% of the cover width, as in the reference) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.34*"/>
                                            <ColumnDefinition Width="0.32*"/>
                                            <ColumnDefinition Width="0.34*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0.34*"/>
                                            <RowDefinition Height="0.32*"/>
                                            <RowDefinition Height="0.34*"/>
                                        </Grid.RowDefinitions>
                                        <Button x:Name="CoverPlayButton" Grid.Column="1" Grid.Row="1"
                                                                                        Cursor="Hand"
                                                                                        Command="{Binding DataContext.PlayPauseTrackCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                                        CommandParameter="{Binding}">
                                                                                    <Button.Style>
                                                                                        <Style TargetType="Button">
                                                                                            <Setter Property="Opacity" Value="0"/>
                                                                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=CoverRoot}" Value="True">
                                                                                                    <DataTrigger.EnterActions>
                                                                                                        <BeginStoryboard>
                                                                                                            <Storyboard>
                                                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                                                            </Storyboard>
                                                                                                        </BeginStoryboard>
                                                                                                    </DataTrigger.EnterActions>
                                                                                                    <DataTrigger.ExitActions>
                                                                                                        <BeginStoryboard>
                                                                                                            <Storyboard>
                                                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                                                            </Storyboard>
                                                                                                        </BeginStoryboard>
                                                                                                    </DataTrigger.ExitActions>
                                                                                                    <Setter Property="Opacity" Value="1"/>
                                                                                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Value="True">
                                                                                                    <DataTrigger.Binding>
                                                                                                        <MultiBinding Converter="{StaticResource IsCurrentTrackPlaying}">
                                                                                                            <Binding/>
                                                                                                            <Binding Path="DataContext.Player.CurrentTrack" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                                                            <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                                                        </MultiBinding>
                                                                                                    </DataTrigger.Binding>
                                                                                                    <DataTrigger.EnterActions>
                                                                                                        <BeginStoryboard>
                                                                                                            <Storyboard>
                                                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                                                            </Storyboard>
                                                                                                        </BeginStoryboard>
                                                                                                    </DataTrigger.EnterActions>
                                                                                                    <DataTrigger.ExitActions>
                                                                                                        <BeginStoryboard>
                                                                                                            <Storyboard>
                                                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                                                            </Storyboard>
                                                                                                        </BeginStoryboard>
                                                                                                    </DataTrigger.ExitActions>
                                                                                                    <Setter Property="Opacity" Value="1"/>
                                                                                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                    <Button.Template>
                                                                                        <ControlTemplate TargetType="Button">
                                                                                            <Grid>
                                                                                                <Border Background="#B3FFFFFF" CornerRadius="24"/>
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="0.30*"/>
                                                                                                        <ColumnDefinition Width="0.40*"/>
                                                                                                        <ColumnDefinition Width="0.30*"/>
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <Grid.RowDefinitions>
                                                                                                        <RowDefinition Height="0.30*"/>
                                                                                                        <RowDefinition Height="0.40*"/>
                                                                                                        <RowDefinition Height="0.30*"/>
                                                                                                    </Grid.RowDefinitions>
                                                                                                    <Viewbox Grid.Column="1" Grid.Row="1" Stretch="Uniform">
                                                                                                        <Path Width="18" Height="18" Stretch="Uniform" Fill="#101010">
                                                                                                            <Path.Style>
                                                                                                                <Style TargetType="Path">
                                                                                                                    <Setter Property="Data" Value="{StaticResource IconPlay}"/>
                                                                                                                    <Style.Triggers>
                                                                                                                        <DataTrigger Value="True">
                                                                                                                            <DataTrigger.Binding>
                                                                                                                                <MultiBinding Converter="{StaticResource IsCurrentTrackPlaying}">
                                                                                                                                    <Binding/>
                                                                                                                                    <Binding Path="DataContext.Player.CurrentTrack" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                                                                                    <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                                                                                </MultiBinding>
                                                                                                                            </DataTrigger.Binding>
                                                                                                                            <Setter Property="Data" Value="{StaticResource IconPause}"/>
                                                                                                                        </DataTrigger>
                                                                                                                    </Style.Triggers>
                                                                                                                </Style>
                                                                                                            </Path.Style>
                                                                                                        </Path>
                                                                                                    </Viewbox>
                                                                                                </Grid>
                                                                                            </Grid>
                                                                                        </ControlTemplate>
                                                                                    </Button.Template>
                                                                                </Button>
                                    </Grid>
                                </Grid>

                            </controls:SquareBorder>

                            <!-- Row 1: heart + title + SoundCloud badge (SC likes on Home) -->
                            <Grid Margin="2,8,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource IconFavoriteOutline}"/>
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource IconFavorite}"/>
                                                    <Setter Property="Fill" Value="{DynamicResource FavoriteBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Platform badge on runtime cards: logo by Source
                                     (soundcloud / vk / yandex); local tracks have no badge -->
                                <Image Grid.Column="2" Width="16" Height="16" Stretch="Uniform"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"
                                        Visibility="{Binding Path=Source, Converter={StaticResource PlatformSource2Vis}, ConverterParameter=soundcloud}" Source="{StaticResource SoundCloudLogoSmall}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Image Grid.Column="2" Width="16" Height="16" Stretch="Uniform"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"
                                        Visibility="{Binding Path=Source, Converter={StaticResource PlatformSource2Vis}, ConverterParameter=vk}" Source="pack://application:,,,/Resources/Logos/vk.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Image Grid.Column="2" Width="16" Height="16" Stretch="Uniform"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"
                                        Visibility="{Binding Path=Source, Converter={StaticResource PlatformSource2Vis}, ConverterParameter=yandex}" Source="{StaticResource YandexMusicGlyphYellow}" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>

                            <!-- Row 2: artist — clicking the name opens the profile; hover: smooth white glow
                                 (shared ArtistHoverTemplate from the theme — the same on all card pages) -->
                            <Button HorizontalAlignment="Left" Cursor="Hand" Margin="2,3,2,0"
                                    Template="{StaticResource ArtistHoverTemplate}"
                                    Command="{Binding DataContext.OpenArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Artist}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick"
                              Command="{Binding PlayTrackCommand}"
                              CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListView}}"/>
            </ListView.InputBindings>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource TrackCardStyle}">
                    <EventSetter Event="MouseDoubleClick" Handler="TrackItem_DoubleClick"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <!-- Explicit styles are required: implicit styles (ContextMenu/MenuItem/Separator)
                     do not apply inside a ContextMenu — its logical tree is detached
                     from the window. Without them the menu renders with the default WPF
                     template: different corners, different indents, blue hover, a "bold"
                     separator with a 30px left indent. -->
                <ContextMenu Style="{StaticResource TrayContextMenuStyle}"
                             Background="{DynamicResource PanelElevatedBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}">
                    <MenuItem Style="{StaticResource {x:Type MenuItem}}"
                              Header="{Binding [Play], Source={x:Static loc:Loc.T}}" FontWeight="Medium"
                              Command="{Binding PlayTrackCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Style="{StaticResource {x:Type MenuItem}}"
                              Header="{Binding [AddToQueue], Source={x:Static loc:Loc.T}}"
                              Command="{Binding AddToQueueCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <!-- Explicit style is required: implicit styles do not apply inside
                         a ContextMenu (its logical tree is detached from the window), and
                         without it the separator renders with the default WPF template —
                         a 30px left indent and a "bold" line. -->
                    <Separator Style="{StaticResource MenuSeparatorStyle}"
                               Background="{DynamicResource BorderBrush}"/>
                    <MenuItem Style="{StaticResource {x:Type MenuItem}}" Header="{Binding [Favorite], Source={x:Static loc:Loc.T}}"
                              Command="{Binding ToggleFavoriteCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator Style="{StaticResource MenuSeparatorStyle}"
                               Background="{DynamicResource BorderBrush}"/>
                    <MenuItem Style="{StaticResource {x:Type MenuItem}}" Header="{Binding [RemoveFromLibrary], Source={x:Static loc:Loc.T}}"
                              Command="{Binding RemoveFromLibraryCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Style="{StaticResource {x:Type MenuItem}}" Header="{Binding [DeleteFromDisk], Source={x:Static loc:Loc.T}}"
                              Foreground="{StaticResource ErrorBrush}"
                              Command="{Binding DeleteFromDiskCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            </ListView>
        </Grid>

        <!-- Empty state: shown when loading finished and there are no tracks (ShowEmptyState).
             The icon is pinned to the CENTER of the page (bottom edge 16px above center),
             text grows downward from center: the icon's anchor point is the same in all
             bars — the background does not "jump" when switching. The icon matches the
             nav item the page was opened from (Home/Favorites/RecentlyPlayed). -->
        <Border Grid.Row="2" Background="Transparent" Margin="24,0,24,12"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource Bool2Vis}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Path Grid.Row="0" Width="64" Height="64" Stretch="Uniform" Margin="0,0,0,16"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Fill="{DynamicResource TextInactiveBrush}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconHome}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PageKind}" Value="Recent">
                                    <Setter Property="Data" Value="{StaticResource IconHistory}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PageKind}" Value="RecentlyPlayed">
                                    <Setter Property="Data" Value="{StaticResource IconHistory}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PageKind}" Value="Favorites">
                                    <Setter Property="Data" Value="{StaticResource IconFavorite}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="{Binding [EmptyLibrary], Source={x:Static loc:Loc.T}}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding [EmptyLibraryHint], Source={x:Static loc:Loc.T}}"
                               FontSize="13" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextInactiveBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
