<Window x:Class="BatPlayer.Views.SoundCloudLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:BatPlayer.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SoundCloud"
        Width="560" Height="760" MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        WindowStyle="None"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
        UseLayoutRounding="True">

    <!-- WindowChrome: WindowStyle=None без него оставляет системную DWM-рамку —
         сверху окна белая полоса (светлая тема Windows). Забираем non-client область
         целиком: рамка исчезает, ресайз (5px) и DragMove из code-behind живут. -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: заголовок + крестик, перетаскивание за верхнюю полосу -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"
                          Source="{StaticResource SoundCloudLogoSmall}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding [SoundCloudLoginTitle], Source={x:Static loc:Loc.T}}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource IconButton}" Width="28" Height="28"
                        Click="CloseButton_Click"
                        ToolTip="{Binding [Close], Source={x:Static loc:Loc.T}}">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="{StaticResource IconClose}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Подсказка: окно закроется само после входа -->
        <TextBlock Grid.Row="1" Margin="16,8,16,8" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding [SoundCloudLoginHint], Source={x:Static loc:Loc.T}}"/>

        <Grid Grid.Row="2">
            <!-- Веб-вью входа (soundcloud.com/login) -->
            <wv2:WebView2 x:Name="Web"
                          DefaultBackgroundColor="Transparent"/>

            <!-- Заглушка, когда WebView2 Runtime не установлен -->
            <Border x:Name="WebviewMissingPanel" Background="{DynamicResource BgBrush}" Margin="16,0,16,16"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <Image Width="48" Height="48" Stretch="Uniform" Margin="0,0,0,16"
                          HorizontalAlignment="Center"
                          Source="pack://application:,,,/Resources/Logos/soundcloud.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding [SoundCloudWebviewMissing], Source={x:Static loc:Loc.T}}"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
