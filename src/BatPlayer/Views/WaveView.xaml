<UserControl x:Class="BatPlayer.Views.WaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:BatPlayer.Converters"
              xmlns:loc="clr-namespace:BatPlayer.Localization"
             xmlns:controls="clr-namespace:BatPlayer.Controls"
             xmlns:views="clr-namespace:BatPlayer.Views"
            >
    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <!-- Card source logo: Yandex by default, VK/SC by Source; local tracks
             have none (their presence is shown by the IconFile badge) -->
        <Style x:Key="WaveSourceLogo" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="Source" Value="{StaticResource YandexMusicGlyphYellow}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="vk">
                    <Setter Property="Source" Value="pack://application:,,,/Resources/Logos/vk.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="soundcloud">
                    <Setter Property="Source" Value="{StaticResource SoundCloudLogoSmall}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="local">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Previous/next card. Dimming is NOT on the button but on each of its
             elements (SideDim*): the cover is animated separately on track change
             and must stay bright in flight, not clamped to 0.38 of the whole button -->
        <Style x:Key="DimSideCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Side card cover dimming: the cover is animated separately on track change
             and must stay bright in flight, not clamped to 0.38 -->
        <Style x:Key="SideDimCover" TargetType="Border">
            <Setter Property="Opacity" Value="0.38"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Side card caption (title+artist) dimming: the panel flies together
             with the cover on track change, so dim it rather than the children -->
        <Style x:Key="SideDimPanel" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0.38"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,14,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="{Binding CounterText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="12" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding [WaveSubtitle], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                    <TextBlock FontSize="12" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding IsGenerating, Converter={StaticResource Bool2Vis}}">
                        <Run Text="{Binding [WaveGenerating], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        ToolTip="{Binding [WaveRefresh], Source={x:Static loc:Loc.T}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="{StaticResource IconRefresh}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Generating (first time, list still empty): panel with a spinning logo -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                Margin="24,0,24,12" Padding="14,10" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsGenerating}" Value="True"/>
                                <Condition Binding="{Binding Cards.Count}" Value="0"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding [WaveGeneratingLong], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                <Border Width="26" Height="26" CornerRadius="13" Margin="8,0,0,0"
                        VerticalAlignment="Center" Background="#FF232428"
                        BorderBrush="#40FFFFFF" BorderThickness="1">
                    <Image Width="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Source="pack://application:,,,/Resources/batlogo_white.png"
                           RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="LoaderRotate" Angle="0"/>
                        </Image.RenderTransform>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Image.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LoaderRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:0.9"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== The wave: previous — left, current — center, next — right ===== -->
        <Grid Grid.Row="2" Margin="24,0,24,12" x:Name="HeroPanel">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HeroCurrent}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <!-- Previous track: dimmed, click goes back to it. Focusable=False: after
                 a click the button does not keep focus — no dotted frame on the card -->
            <Button Grid.Column="0" x:Name="HeroPrevButton" Command="{Binding PlayCardCommand}" CommandParameter="{Binding HeroPrev}"
                    VerticalAlignment="Center" Margin="0,0,8,0" Focusable="False">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="PrevButtonShift"/>
                </Button.RenderTransform>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DimSideCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HeroPrev}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <!-- Body: cover + caption. Fades in when a NEW card appears -->
                    <StackPanel x:Name="HeroPrevBody">
                        <!-- Square cover (1:1 to the column width): no cropping top/bottom.
                             RenderTransform is driven by code-behind: flight from the center
                             on track change -->
                        <controls:SquareBorder x:Name="HeroPrevCover" Style="{StaticResource SideDimCover}"
                                CornerRadius="5" Background="{DynamicResource SecondaryBrush}">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PrevCoverScale"/>
                                    <TranslateTransform x:Name="PrevCoverShift"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid>
                                <Image Width="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Source="pack://application:,,,/Resources/batlogo_gray.png"/>
                                <Border CornerRadius="5" controls:LazyCover.Path="{Binding HeroPrev.ArtworkLocalPath}">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </controls:SquareBorder>
                        <!-- Caption follows the cover in a short drift without scale
                             (transform driven by code-behind): scaling small text looked off -->
                        <StackPanel x:Name="HeroPrevText" Style="{StaticResource SideDimPanel}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PrevTextShift"/>
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{Binding HeroPrev.Title}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding HeroPrev.DisplayArtist}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Current track: large centered cover + title -->
            <StackPanel Grid.Column="1" x:Name="HeroCurrentPanel"
                        VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                <!-- Square cover 1:1 to the zone width (Viewbox shrinks on small windows).
                     RenderTransform is driven by code-behind: on track change the cover flies
                     in from the neighboring card's slot -->
                <Viewbox x:Name="HeroCoverBox" Stretch="Uniform" MaxWidth="440" MaxHeight="440" HorizontalAlignment="Center">
                    <Viewbox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="HeroCoverScale"/>
                            <TranslateTransform x:Name="HeroCoverShift"/>
                        </TransformGroup>
                    </Viewbox.RenderTransform>
                    <Grid Width="400" Height="400">
                        <Border x:Name="CoverRoot" CornerRadius="14" Background="{DynamicResource SecondaryBrush}">
                            <Grid>
                                <!-- Placeholder WHILE the cover is loading -->
                                <Image Width="120" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Source="pack://application:,,,/Resources/batlogo_gray.png"/>
                                <Border CornerRadius="14" controls:LazyCover.Path="{Binding HeroCurrent.ArtworkLocalPath}">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- Full-surface Play/Pause button: the whole cover is clickable,
                                     the dim and round icon appear on hover -->
                                <Button Command="{Binding PlayCardCommand}" CommandParameter="{Binding HeroCurrent}"
                                        Cursor="Hand" Focusable="False">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid>
                                                            <Border CornerRadius="14" Background="#59000000"/>
                                                    <Grid Width="96" Height="96">
                                                        <!-- Rounded square instead of a circle — logo language -->
                                                        <Border Background="#B3FFFFFF" CornerRadius="24"/>
                                                        <Path x:Name="PlayPauseIcon" Width="40" Height="40"
                                                              Stretch="Uniform" Fill="#101010"
                                                              Data="{StaticResource IconPlay}"/>
                                                    </Grid>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeroPlaying}" Value="True">
                                                                <Setter TargetName="PlayPauseIcon" Property="Data"
                                                                        Value="{StaticResource IconPause}"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=CoverRoot}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- "Available locally" badge -->
                                <Border CornerRadius="8" Background="#CC101010" Width="26" Height="26"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                                        ToolTip="{Binding [YmLocalMatch], Source={x:Static loc:Loc.T}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HeroCurrent.HasLocalMatch}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="#FFFFFF" Data="{StaticResource IconFile}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Viewbox>

                <!-- Title / artist / source: flies together with the cover. Width is
                     fixed to the cover (the inner Grid centers itself) — otherwise the
                     panel would jump when the title length changes -->
                <StackPanel x:Name="HeroCurrentText" Margin="8,20,8,0" HorizontalAlignment="Center" MaxWidth="440"
                            Width="{Binding ActualWidth, ElementName=HeroCoverBox}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="CurTextShift"/>
                    </StackPanel.RenderTransform>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding HeroCurrent.Title}"
                                   FontSize="19" FontWeight="SemiBold" TextAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Image Grid.Column="1" Style="{StaticResource WaveSourceLogo}"
                               VerticalAlignment="Center" Margin="8,2,0,0"
                               DataContext="{Binding HeroCurrent}"/>
                    </Grid>
                    <Button HorizontalAlignment="Center" Cursor="Hand" Margin="0,4,0,0"
                            Template="{StaticResource ArtistHoverTemplate}"
                            Command="{Binding DataContext.OpenArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding HeroCurrent.Artist}"
                            DataContext="{Binding HeroCurrent}"/>
                </StackPanel>
            </StackPanel>

            <!-- Next track: dimmed, click goes forward. Focusable=False — no dotted frame after a click -->
            <Button Grid.Column="2" x:Name="HeroNextButton" Command="{Binding PlayCardCommand}" CommandParameter="{Binding HeroNext}"
                    VerticalAlignment="Center" Margin="8,0,0,0" HorizontalContentAlignment="Right" Focusable="False">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="NextButtonShift"/>
                </Button.RenderTransform>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DimSideCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HeroNext}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <!-- Body: cover + caption. Fades in when a NEW card appears -->
                    <StackPanel x:Name="HeroNextBody">
                        <!-- Square cover (1:1 to the column width): no cropping top/bottom.
                             RenderTransform is driven by code-behind: flight from the center
                             on track change -->
                        <controls:SquareBorder x:Name="HeroNextCover" Style="{StaticResource SideDimCover}"
                                CornerRadius="5" Background="{DynamicResource SecondaryBrush}">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="NextCoverScale"/>
                                    <TranslateTransform x:Name="NextCoverShift"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid>
                                <Image Width="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Source="pack://application:,,,/Resources/batlogo_gray.png"/>
                                <Border CornerRadius="5" controls:LazyCover.Path="{Binding HeroNext.ArtworkLocalPath}">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </controls:SquareBorder>
                        <!-- Caption follows the cover in a short drift without scale -->
                        <StackPanel x:Name="HeroNextText" Style="{StaticResource SideDimPanel}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="NextTextShift"/>
                            </StackPanel.RenderTransform>
                            <TextBlock Text="{Binding HeroNext.Title}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding HeroNext.DisplayArtist}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

<!-- Empty state: icon is pinned to the CENTER of the page (bottom edge 16px above
             center), text grows downward from center — the icon's anchor point is the same
             in all bars, so the background does not "jump" when switching -->
        <Border Grid.Row="2" Background="Transparent" Margin="24,0,24,12"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource Bool2Vis}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Path Grid.Row="0" Width="64" Height="64" Stretch="Uniform" Margin="0,0,0,16"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Fill="{DynamicResource TextInactiveBrush}" Data="{StaticResource IconSparkle}"/>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="{Binding [WaveEmpty], Source={x:Static loc:Loc.T}}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding [WaveEmptyHint], Source={x:Static loc:Loc.T}}"
                               FontSize="13" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextInactiveBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
