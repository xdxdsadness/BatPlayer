<Window x:Class="BatPlayer.Views.NowPlayingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:BatPlayer.Converters"
        xmlns:controls="clr-namespace:BatPlayer.Controls"
         xmlns:loc="clr-namespace:BatPlayer.Localization"
        Style="{StaticResource MainWindowStyle}"
        Title="Now Playing"
        Height="720" Width="1000"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <cv:TimeSpanToStringConverter x:Key="TimeStr"/>
        <cv:PathToImageConverter x:Key="Path2Img"/>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                    CornerRadius="12,12,0,0"
                     MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding [NowPlayingHeader], Source={x:Static loc:Loc.T}}" Margin="16,0" FontSize="11"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="BtnMin_Click">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                              Data="{StaticResource IconMinimize}"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="BtnClose_Click">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                              Data="{StaticResource IconClose}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Big cover -->
                <Grid Grid.Column="0" Margin="48">
                    <Border CornerRadius="16" Background="{DynamicResource PanelBrush}">
                        <Grid>
                            <!-- Два слоя: кроссфейд обложки при смене трека (ведёт code-behind) -->
                            <Image x:Name="NowCoverLayerA" Stretch="Uniform" Opacity="0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="NowCoverLayerB" Stretch="Uniform" Opacity="0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <Border x:Name="NowBatBorder" CornerRadius="16" Background="{DynamicResource PanelBrush}">
                        <!-- Нет обложки: серый силуэт мыши — индикатор неактивного трека.
                             Прозрачностью ведёт code-behind вместе со слоями обложки. -->
                        <Image Width="280" Stretch="Uniform" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Source="pack://application:,,,/Resources/batlogo_gray.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>

                <!-- Track info + lyrics -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,32,24,24">
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding CurrentTrack.DisplayTitle}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTrack}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{Binding [NoTrack], Source={x:Static loc:Loc.T}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentTrack.DisplayArtist, FallbackValue='—'}" FontSize="16" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentTrack.DisplayAlbum, FallbackValue='—'}" FontSize="13" Margin="0,2,0,16"
                                   Foreground="{DynamicResource TextInactiveBrush}" TextWrapping="Wrap"/>

                        <!-- Quality info -->
                        <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding [FileInformation], Source={x:Static loc:Loc.T}}" FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [ColFormat], Source={x:Static loc:Loc.T}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentTrack.Format, FallbackValue='—'}" FontSize="12"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [ColQuality], Source={x:Static loc:Loc.T}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentTrack.QualityDisplay, FallbackValue='—'}" FontSize="12"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [Bitrate], Source={x:Static loc:Loc.T}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="12"
                                               Text="{Binding CurrentTrack.Bitrate, StringFormat={}{0} kbps, FallbackValue='—'}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [SampleRate], Source={x:Static loc:Loc.T}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="12"
                                               Text="{Binding CurrentTrack.SampleRate, StringFormat={}{0} Hz, FallbackValue='—'}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [Channels], Source={x:Static loc:Loc.T}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentTrack.Channels, FallbackValue='—'}" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Lyrics placeholder -->
                        <TextBlock Text="{Binding [Lyrics], Source={x:Static loc:Loc.T}}" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="8" Padding="14,10"
                                MinHeight="120">
                            <TextBlock Text="{Binding [LyricsUnavailable], Source={x:Static loc:Loc.T}}"
                                       FontSize="12" Foreground="{DynamicResource TextInactiveBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bottom transport -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                    CornerRadius="0,0,12,12"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Transport: spans both columns so it is centered on the bar -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Margin="0,0,16,0"
                                Command="{Binding PreviousCommand}">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{DynamicResource TextPrimaryBrush}" Data="{StaticResource IconPrev}"/>
                        </Button>
                        <Button Style="{StaticResource PlayIconButton}" Margin="0,0,16,0"
                                Command="{Binding PlayPauseCommand}">
                            <Path Width="22" Height="22" Stretch="Uniform" Fill="#101010"
                                  RenderTransformOrigin="0.5,0.5"
                                  >
                                <Path.RenderTransform>
                                    <ScaleTransform/>
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">                                        <Setter Property="Data" Value="{StaticResource IconPlay}"/>
                                        <!-- Оптическое центрирование play-треугольника (см. MainWindow) -->
                                        <Setter Property="Margin" Value="2.5,0,0,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconPause}"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.6" To="1" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase Amplitude="2.5" EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.6" To="1" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase Amplitude="2.5" EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.6" To="1" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase Amplitude="2.5" EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.6" To="1" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase Amplitude="2.5" EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}">
                            <Path Width="20" Height="20" Stretch="Uniform"
                                  Fill="{DynamicResource TextPrimaryBrush}" Data="{StaticResource IconNext}"/>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Width="180">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Position, Converter={StaticResource TimeStr}}"
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource AppFontMono}"/>
                        <controls:WaveformTimeline Grid.Column="1" Height="40" VerticalAlignment="Center" Margin="6,0"
                                PeaksSource="{Binding CurrentTrack.FilePath, Mode=OneWay}"
                                PositionSeconds="{Binding Position.TotalSeconds, Mode=OneWay}"
                                DurationSeconds="{Binding Duration.TotalSeconds, Mode=OneWay}"
                                SeekCommand="{Binding SeekToCommand}"
                                PlayedBrush="{DynamicResource AccentBrush}"
                                UnplayedBrush="#55555555"
                                PlayheadBrush="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Duration, Converter={StaticResource TimeStr}}"
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource AppFontMono}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
