<UserControl x:Class="BatPlayer.Views.SoundCloudLikesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:BatPlayer.Converters"
              xmlns:loc="clr-namespace:BatPlayer.Localization"
             xmlns:controls="clr-namespace:BatPlayer.Controls"
            >
    <UserControl.Resources>
        <!-- Обложки биндим на локальный кэш (Path2Img): i1.sndcdn.com блокирует прямые
             подключения, поэтому BitmapImage по http-ссылке обложку не получает. -->
        <cv:PathToImageConverter x:Key="Path2Img"/>
        <cv:EmptyToVisibilityConverter x:Key="Empty2Vis"/>
        <cv:TimeSpanToStringConverter x:Key="TimeStr"/>
        <cv:InverseIntToVisibilityConverter x:Key="InverseInt2Vis"/>
        <cv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBool2Vis"/>
        <cv:PlatformCardPlayingConverter x:Key="PlatformCardPlaying"/>
        <!-- Плавное появление hover-оверлея и play-кнопки карточки (fade вместо мгновенного переключения) -->
        <Style x:Key="CardHoverFade" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=CoverRoot}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource PlatformCardPlaying}" ConverterParameter="soundcloud">
                            <Binding Path="ScId"/>
                            <Binding Path="DataContext.Player.CurrentTrack.ScId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="DataContext.Player.CurrentTrack.Source" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <!-- ExitActions обязателен: без него при смене трека (особенно после
                         пересборки списка) Enter-анимация оставалась висеть на opacity=1 —
                         на нескольких карточках «залипали» заставки play/pause. -->
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Контейнер карточки: по образцу TrackCardStyle/ArtistCardStyle, без подсветки выделения -->
        <Style x:Key="ScCardStyle" TargetType="ListViewItem" BasedOn="{StaticResource TrackCardStyle}">
            <!-- Шаблон НЕ переопределяется: hover-scale и пружина нажатия наследуются из TrackCardStyle (раньше голый ContentPresenter отключал их — анимации наведения работали только на Home) -->
            <EventSetter Event="MouseLeftButtonUp" Handler="Card_Click"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="PageHeader" Grid.Row="0" Margin="32,14,24,8" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Заголовок как в Home: зазор между крупным и мелким текстом = 3px,
                 не зависит от высоты кнопок справа -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="{Binding CounterText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock FontSize="12" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding [LastSynced], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                        <Run Text="{Binding LastSyncedText, Mode=OneWay}"/>
                    </TextBlock>
                    <!-- Статус загрузки трека в кэш (показывается только пока IsLoadingTrack) -->
                    <TextBlock FontSize="12" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding IsLoadingTrack, Converter={StaticResource Bool2Vis}}">
                        <Run Text="{Binding [SoundCloudDownloading], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            <!-- Кнопки правее, по центру блока заголовка -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                
                
            <Button Style="{StaticResource IconButton}" Margin="12,0,0,0" VerticalAlignment="Center"
        Command="{Binding ShuffleCardsCommand}"
        ToolTip="{Binding [Shuffle], Source={x:Static loc:Loc.T}}">
    <Path Width="16" Height="16" Stretch="Uniform"
          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
          Data="{StaticResource IconShuffle}"/>
</Button><Button Style="{StaticResource IconButton}" Margin="12,0,0,0" VerticalAlignment="Center"
        Command="{Binding SyncNowCommand}"
        ToolTip="{Binding [SyncNow], Source={x:Static loc:Loc.T}}">
    <Path Width="16" Height="16" Stretch="Uniform"
          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
          Data="{StaticResource IconSync}"/>
</Button></StackPanel>
        </Grid>

        <!-- Sync progress: как панель сканирования в LibraryView -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                Margin="24,0,24,12" Padding="14,10" CornerRadius="8"
                Visibility="{Binding IsSyncing, Converter={StaticResource Bool2Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding [SoundCloudSyncing], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- Счётчик фиксированной ширины: растущие цифры не сдвигают бейдж -->
                        <TextBlock FontSize="13" Width="72" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding SyncProgress, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding SyncTotal, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- Вращающийся логотип во время синка -->
                        <!-- Тёмный бейдж: белый силуэт виден и в тёмной, и в светлой теме -->
                        <Border Width="26" Height="26" CornerRadius="13" Margin="8,0,0,0"
                                VerticalAlignment="Center" Background="#FF232428"
                                BorderBrush="#40FFFFFF" BorderThickness="1">
                            <Image Width="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Source="pack://application:,,,/Resources/batlogo_white.png"
                                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="SyncProgressRotate" Angle="0"/>
                                </Image.RenderTransform>
                                <Image.Triggers>
                                    <EventTrigger RoutedEvent="Image.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SyncProgressRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:0.9"
                                                                 RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Image.Triggers>
                            </Image>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <ProgressBar Grid.Column="1" Style="{StaticResource ProgressBarSlim}"
                             Width="200" Minimum="0" Maximum="{Binding SyncTotal, Mode=OneWay}"
                             Value="{Binding SyncProgress, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- Карточки: копия LibraryView (обложка 1:1, hover-оверлей, сердечко, название, исполнитель) -->
        <Grid Grid.Row="2" Margin="24,0,16,4">
            <ListView controls:ScrollHeaderCollapse.Header="{Binding ElementName=PageHeader}" ScrollViewer.CanContentScroll="True" Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding Cards}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VerticalContentAlignment="Stretch">
                <!-- На время загрузки список свёрнут: виртуализация не генерирует
                     контейнеры для старых карточек, при клике по бару нет тройной
                     работы (создать старые → очистить → создать новые) — переход
                     без лагов. Без скелетона и fade: чистое появление по готовности. -->
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Opacity="{Binding CardOpacity}">
                            <!-- Квадратная обложка (1:1) на всю ширину карточки.
                                 SquareBorder: квадрат уже в measure — без двойного
                                 прохода компоновки биндинга на ActualWidth. -->
                            <controls:SquareBorder x:Name="CoverRoot" CornerRadius="8"
                                        Background="{DynamicResource SecondaryBrush}">
                                <Grid>
                                    <!-- Обложка из локального кэша (artwork_local_path); файла нет — LazyCover
                                         скачает её по требованию (SetFileLoader). Спиннер — пока идёт загрузка. -->
                                    <!-- Логотип-плейсхолдер: серый силуэт (CardBatPlaceholder —
                                         общий стиль всех баров, см. DarkTheme; статичный) -->
                                    <Image Style="{StaticResource CardBatPlaceholder}"/>
<Border CornerRadius="8" controls:LazyCover.Path="{Binding ArtworkLocalPath}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=(controls:LazyCover.HasImage), RelativeSource={RelativeSource Self}}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.3"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>

                                    <!-- Полупрозрачный белый оверлей: при наведении ИЛИ когда играет этот трек -->
                                    <Border x:Name="CoverHoverOverlay" CornerRadius="8"
                                            Background="#40FFFFFF" IsHitTestVisible="False"
                                            Style="{StaticResource CardHoverFade}"/>

                                    <!-- Центральная кнопка Play (меняется на Pause, когда играет этот трек) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.34*"/>
                                            <ColumnDefinition Width="0.32*"/>
                                            <ColumnDefinition Width="0.34*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0.34*"/>
                                            <RowDefinition Height="0.32*"/>
                                            <RowDefinition Height="0.34*"/>
                                        </Grid.RowDefinitions>

                                        <Button x:Name="CoverPlayButton" Grid.Column="1" Grid.Row="1"
                                                Cursor="Hand"
                                                Style="{StaticResource CardHoverFade}"
                                                Command="{Binding DataContext.PlayCardCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Border Background="#B3FFFFFF" CornerRadius="24"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="0.30*"/>
                                                                <ColumnDefinition Width="0.40*"/>
                                                                <ColumnDefinition Width="0.30*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="0.30*"/>
                                                                <RowDefinition Height="0.40*"/>
                                                                <RowDefinition Height="0.30*"/>
                                                            </Grid.RowDefinitions>
                                                            <Viewbox Grid.Column="1" Grid.Row="1" Stretch="Uniform">
                                                                <Path Width="18" Height="18" Stretch="Uniform" Fill="#101010">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Data" Value="{StaticResource IconPlay}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Value="True">
                                                                                    <DataTrigger.Binding>
                                                                                        <MultiBinding Converter="{StaticResource PlatformCardPlaying}" ConverterParameter="soundcloud">
                                                                <Binding Path="ScId"/>
                                                                <Binding Path="DataContext.Player.CurrentTrack.ScId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                <Binding Path="DataContext.Player.CurrentTrack.Source" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                                                    </DataTrigger.Binding>
                                                                                    <Setter Property="Data" Value="{StaticResource IconPause}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Viewbox>
                                                        </Grid>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- Бейдж «есть локально» (IconFile) в правом верхнем углу обложки -->
                                    <Border CornerRadius="6" Background="#CC101010" Width="22" Height="22"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                            ToolTip="{Binding [SoundCloudLocalMatch], Source={x:Static loc:Loc.T}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLocalMatch}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Fill="#FFFFFF" Data="{StaticResource IconFile}"/>
                                    </Border>
                                </Grid>
                            </controls:SquareBorder>

                            <!-- Строка 1: залитое сердечко (трек лайкнут) + название + лого платформы -->
                            <Grid Margin="2,8,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                      Data="{StaticResource IconFavorite}"
                                      Fill="{DynamicResource FavoriteBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Лого SoundCloud напротив названия -->
                                <Image Grid.Column="2" Width="18" Height="18" Stretch="Uniform"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0" Source="{StaticResource SoundCloudLogoSmall}" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>

                            <!-- Строка 2: исполнитель — клик по имени открывает профиль -->
                            <Button HorizontalAlignment="Left" Cursor="Hand" Margin="2,3,2,0"
                                    Opacity="0"
                                    Template="{StaticResource ArtistHoverTemplate}"
                                    Command="{Binding DataContext.OpenArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Artist}">
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="Button.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" BeginTime="0:0:1.1" Duration="0:0:0.45"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ScCardStyle}"/>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

<!-- Empty state: иконка прижата к ЦЕНТРУ страницы (нижний край — за 16px до
             центра), текст растёт вниз от центра — точка иконки одинакова во всех барах,
             при переключении задний фон не «прыгает» -->
        <Border Grid.Row="2" Background="Transparent" Margin="24,0,24,12"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource Bool2Vis}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Image Grid.Row="0" Width="64" Height="64" Stretch="Uniform" Margin="0,0,0,16"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Source="pack://application:,,,/Resources/Logos/soundcloud.grey.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="{Binding [SoundCloudEmpty], Source={x:Static loc:Loc.T}}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding [SoundCloudEmptyHint], Source={x:Static loc:Loc.T}}"
                               FontSize="13" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextInactiveBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
