<UserControl x:Class="BatPlayer.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BatPlayer.Localization"
             xmlns:cv="clr-namespace:BatPlayer.Converters"
            >
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis"/>
        <cv:EnumEqualsToBoolConverter x:Key="EnumEqualsBool"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="32,14,24,8">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding CounterText}" FontSize="12" Margin="0,3,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Period switcher: IsChecked is two-way bound to VM.Period so the selection
             always reflects the actual data period -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="32,4,24,12">
            <RadioButton GroupName="StatsPeriod" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                         IsChecked="{Binding Period, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Day, Mode=TwoWay}"
                         Content="{Binding [StatsDay], Source={x:Static loc:Loc.T}}"
                         Command="{Binding SetPeriodCommand}" CommandParameter="Day"/>
            <RadioButton GroupName="StatsPeriod" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                         IsChecked="{Binding Period, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Week, Mode=TwoWay}"
                         Content="{Binding [StatsWeek], Source={x:Static loc:Loc.T}}"
                         Command="{Binding SetPeriodCommand}" CommandParameter="Week"/>
            <RadioButton GroupName="StatsPeriod" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                         IsChecked="{Binding Period, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Month, Mode=TwoWay}"
                         Content="{Binding [StatsMonth], Source={x:Static loc:Loc.T}}"
                         Command="{Binding SetPeriodCommand}" CommandParameter="Month"/>
            <RadioButton GroupName="StatsPeriod" Style="{StaticResource NavButton}" Margin="0,0,8,0"
                         IsChecked="{Binding Period, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Year, Mode=TwoWay}"
                         Content="{Binding [StatsYear], Source={x:Static loc:Loc.T}}"
                         Command="{Binding SetPeriodCommand}" CommandParameter="Year"/>
            <RadioButton GroupName="StatsPeriod" Style="{StaticResource NavButton}"
                         IsChecked="{Binding Period, Converter={StaticResource EnumEqualsBool}, ConverterParameter=All, Mode=TwoWay}"
                         Content="{Binding [StatsAll], Source={x:Static loc:Loc.T}}"
                         Command="{Binding SetPeriodCommand}" CommandParameter="All"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="24,0,16,12">
            <StackPanel>

                <!-- Summary tiles -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,12,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding UniqueTracksText}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding [StatsUniqueTracks], Source={x:Static loc:Loc.T}}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="0,0,12,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding PlaysText}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding [StatsPlays], Source={x:Static loc:Loc.T}}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding HoursText}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding [StatsHours], Source={x:Static loc:Loc.T}}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Most replayed -->
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16" Padding="16"
                        Visibility="{Binding HasMostReplayed, Converter={StaticResource Bool2Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [StatsMostReplayed], Source={x:Static loc:Loc.T}}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding MostReplayedText}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top 5 artists -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,12,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding [StatsTopArtists], Source={x:Static loc:Loc.T}}"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding TopArtists}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Index}" FontSize="12"
                                                       Foreground="{DynamicResource TextInactiveBrush}"
                                                       Margin="0,0,8,0" VerticalAlignment="Center" Grid.Column="0"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Artist}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Plays}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Grid.Column="2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Top 10 tracks -->
                    <Border Grid.Column="1" Style="{StaticResource CardPanel}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding [StatsTopTracks], Source={x:Static loc:Loc.T}}"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding TopTracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Index}" FontSize="12"
                                                       Foreground="{DynamicResource TextInactiveBrush}"
                                                       Margin="0,0,8,0" VerticalAlignment="Center" Grid.Column="0"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Run Text=" — " FontSize="12" Foreground="{DynamicResource TextInactiveBrush}"/>
                                                <Run Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Plays}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Grid.Column="2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
