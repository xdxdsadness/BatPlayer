<Window x:Class="BatPlayer.Views.YmLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:loc="clr-namespace:BatPlayer.Localization"
        Title="Yandex Music"
        Icon="pack://application:,,,/Resources/Logos/yandex.png"
        Width="460" Height="420" MinWidth="400" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        WindowStyle="None"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
        UseLayoutRounding="True" ResizeMode="CanMinimize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: heading + close button, drag by the top strip -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"
                          Source="pack://application:,,,/Resources/Logos/yandex.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding [YmLoginTitle], Source={x:Static loc:Loc.T}}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource IconButton}" Width="28" Height="28"
                        Click="CloseButton_Click"
                        ToolTip="{Binding [Close], Source={x:Static loc:Loc.T}}">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="{StaticResource IconClose}"/>
                </Button>
            </Grid>
        </Border>

        <!-- OAuth Device Flow sign-in: the player shows a code, the user enters it
             on the official Yandex ID page in a browser; the token is polled -->
        <StackPanel Grid.Row="1" Margin="24,16,24,20">
            <TextBlock Text="{Binding [YmDeviceIntro], Source={x:Static loc:Loc.T}}"
                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- Confirmation code: large, monospaced, copied by button -->
            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Margin="0,16,0,4" Padding="16,10">
                <TextBlock x:Name="UserCodeText"
                           FontSize="26" FontWeight="Bold"
                           FontFamily="Consolas, Cascadia Mono, Courier New"
                           TextAlignment="Center" Text="— — — —"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Border>

            <TextBlock Text="{Binding [YmDeviceCodeHint], Source={x:Static loc:Loc.T}}"
                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,2,0,16"/>

            <Button x:Name="OpenPageButton" Style="{StaticResource AccentButton}"
                    Click="OpenPageButton_Click" Margin="0,0,0,10" Padding="0,9">
                <TextBlock Text="{Binding [YmDeviceOpen], Source={x:Static loc:Loc.T}}"/>
            </Button>

            <Button x:Name="RetryButton" Style="{StaticResource PrimaryButton}"
                    Click="RetryButton_Click" Visibility="Collapsed" Padding="0,8">
                <TextBlock Text="{Binding [YmDeviceRetry], Source={x:Static loc:Loc.T}}"/>
            </Button>

            <!-- Status: waiting for approval / code expired / network failure / approved -->
            <TextBlock x:Name="StatusText" Margin="0,8,0,0"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding [YmDeviceWaiting], Source={x:Static loc:Loc.T}}"/>
        </StackPanel>
    </Grid>
</Window>
