<UserControl x:Class="BatPlayer.Views.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:BatPlayer.Converters"
             xmlns:controls="clr-namespace:BatPlayer.Controls"
              xmlns:loc="clr-namespace:BatPlayer.Localization"
            >
    <UserControl.Resources>
        <cv:TimeSpanToStringConverter x:Key="TimeStr"/>
        <cv:PathToImageConverter x:Key="Path2Img"/>
        <cv:SnapToRowsConverter x:Key="SnapRows"/>
        <cv:IntToVisibilityConverter x:Key="Int2Vis"/>
        <cv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBool2Vis"/>
        <cv:InverseIntToVisibilityConverter x:Key="InvInt2Vis"/>
        <!-- Играет ли очередь ЭТОГО плейлиста (Pause-состояние карточки) -->
        <cv:PlaylistCardPlayingConverter x:Key="IsCurrentPlaylistPlaying"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,14,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding Playlists.Count, Mode=OneWay, FallbackValue=0}"/>
                    <Run Text="{Binding [Playlists], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="12,6" VerticalAlignment="Center"
                    Command="{Binding CreatePlaylistCommand}" ToolTip="{Binding [CreatePlaylist], Source={x:Static loc:Loc.T}}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"
                          Fill="#101010" Data="{StaticResource IconAdd}"/>
                    <TextBlock Text="{Binding [CreatePlaylist], Source={x:Static loc:Loc.T}}" FontSize="13"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== Сетка плейлистов (как у остальных баров) ===== -->
        <Grid Grid.Row="1" Margin="24,0,16,4"
              Visibility="{Binding IsDetailView, Converter={StaticResource InvBool2Vis}}">
            <ListView Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding Playlists}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- Контейнер без стандартного chrome ListView: дефолтный шаблон
                     подсвечивал карточку системным синим при наведении/выделении.
                     Hover рисует сама карточка в DataTemplate. -->
                <ListView.ItemContainerStyle>
                    <!-- TrackCardStyle: те же поля 8,4,8,24 и растягивание по слоту,
                         что у карточек библиотеки и платформ — расстояния совпадают,
                         а при смене плотности сетки карточки пережимаются вместе со слотом
                         (прежний корневой StackPanel с Width-биндингом на собственную
                         обложку залипал на старой ширине и «сжимал» карточки). -->
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource TrackCardStyle}"/>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- Без Width-биндинга на собственную обложку: слот ширины даёт
                             контейнер ListViewItem (Stretch) — как на платформенных страницах -->
                        <StackPanel Cursor="Hand">
                            <!-- Квадратная обложка (1:1). SquareBorder: квадрат уже в
                                 measure — без двойного прохода компоновки self-биндинга. -->
                            <controls:SquareBorder x:Name="PlCoverRoot" CornerRadius="8"
                                    Background="{DynamicResource SecondaryBrush}">
                                <Grid>
                                    <Border CornerRadius="8" controls:LazyCover.Path="{Binding CoverPath}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=(controls:LazyCover.HasImage), RelativeSource={RelativeSource Self}}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.3"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <!-- Нет обложки: серый силуэт мыши — как на остальных страницах -->
                                    <Image Width="64" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Source="pack://application:,,,/Resources/batlogo_gray.png"
                                           Visibility="{Binding CoverPath, Converter={StaticResource InvBool2Vis}}" RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <Border CornerRadius="8" Background="#40FFFFFF" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=PlCoverRoot}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                    <!-- Оверлей держится, пока играет очередь ЭТОГО
                                                         плейлиста — как у карточки играющего трека -->
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource IsCurrentPlaylistPlaying}">
                                                                <Binding Path="Id"/>
                                                                <Binding Path="DataContext.Player.CurrentPlaylistId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Button Grid.Column="1" Cursor="Hand"
                                            Command="{Binding DataContext.PlayPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=PlCoverRoot}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="IsHitTestVisible" Value="True"/>
                                                    </DataTrigger>
                                                    <!-- Кнопка видна и без наведения, пока играет этот плейлист -->
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource IsCurrentPlaylistPlaying}">
                                                                <Binding Path="Id"/>
                                                                <Binding Path="DataContext.Player.CurrentPlaylistId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" FillBehavior="Stop"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="IsHitTestVisible" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <!-- Как у карточек на остальных страницах: кнопка
                                                     накрывает обложку целиком (зона наведения), но
                                                     белая плашка 40% сидит в СРЕДНЕЙ ячейке 3x3,
                                                     а не растягивается на всю обложку -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.34*"/>
                                                        <ColumnDefinition Width="0.32*"/>
                                                        <ColumnDefinition Width="0.34*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="0.34*"/>
                                                        <RowDefinition Height="0.32*"/>
                                                        <RowDefinition Height="0.34*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Column="1" Grid.Row="1">
                                                        <Border Background="#B3FFFFFF" CornerRadius="24"/>
                                                        <!-- Вложенная сетка: иконка = 40% плашки,
                                                             как у карточек SC/YM/VK/Spotify -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="0.30*"/>
                                                                <ColumnDefinition Width="0.40*"/>
                                                                <ColumnDefinition Width="0.30*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="0.30*"/>
                                                                <RowDefinition Height="0.40*"/>
                                                                <RowDefinition Height="0.30*"/>
                                                            </Grid.RowDefinitions>
                                                            <Viewbox Grid.Column="1" Grid.Row="1" Stretch="Uniform">
                                                                <Path Width="18" Height="18" Stretch="Uniform" Fill="#101010">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Data" Value="{StaticResource IconPlay}"/>
                                                                            <Style.Triggers>
                                                                                <!-- Play → Pause, пока играет очередь этого плейлиста -->
                                                                                <DataTrigger Value="True">
                                                                                    <DataTrigger.Binding>
                                                                                        <MultiBinding Converter="{StaticResource IsCurrentPlaylistPlaying}">
                                                                                            <Binding Path="Id"/>
                                                                                            <Binding Path="DataContext.Player.CurrentPlaylistId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                                            <Binding Path="DataContext.Player.IsPlaying" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                                        </MultiBinding>
                                                                                    </DataTrigger.Binding>
                                                                                    <Setter Property="Data" Value="{StaticResource IconPause}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Viewbox>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </controls:SquareBorder>

                            <!-- Название + действия + N треков -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                      CommandParameter="{Binding}"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                            Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding [Play], Source={x:Static loc:Loc.T}}">
                                        <Path Width="11" Height="11" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconPlay}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                            Command="{Binding DataContext.RenamePlaylistDialogCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding [PlaylistRename], Source={x:Static loc:Loc.T}}">
                                        <Path Width="11" Height="11" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconEdit}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                            Command="{Binding DataContext.ChangeCoverCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding [PlaylistChangeCover], Source={x:Static loc:Loc.T}}">
                                        <Path Width="11" Height="11" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconAlbum}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                            Command="{Binding DataContext.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding [Delete], Source={x:Static loc:Loc.T}}">
                                        <Path Width="11" Height="11" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconClose}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBlock FontSize="11" Margin="2,3,2,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding TrackCount, Mode=OneWay}"/>
                                <Run Text="{Binding [Tracks], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ===== Детали плейлиста (треки) ===== -->
        <Grid Grid.Row="1" Visibility="{Binding IsDetailView, Converter={StaticResource Bool2Vis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,6,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Margin="0,0,10,0"
                                Command="{Binding CloseDetailViewCommand}"
                                ToolTip="{Binding [Back], Source={x:Static loc:Loc.T}}">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M15.4,7.4 L14,6 L8,12 L14,18 L15.4,16.6 L10.8,12 Z"/>
                        </Button>
                        <TextBlock Text="{Binding SelectedPlaylist.Name}" FontSize="20" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock FontSize="12" Margin="42,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding TotalTrackCount, Mode=OneWay, FallbackValue=0}"/>
                        <Run Text="{Binding [Tracks], Source={x:Static loc:Loc.T}, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding ShufflePlaylistCommand}">
                        <TextBlock Text="{Binding [Shuffle], Source={x:Static loc:Loc.T}}" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding PlayPlaylistCommand}"
                            CommandParameter="{Binding SelectedPlaylist}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                  Fill="#101010" Data="{StaticResource IconPlay}"/>
                            <TextBlock Text="{Binding [Play], Source={x:Static loc:Loc.T}}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding RenamePlaylistDialogCommand}"
                            CommandParameter="{Binding SelectedPlaylist}">
                        <TextBlock Text="{Binding [PlaylistRename], Source={x:Static loc:Loc.T}}" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding ChangeCoverCommand}"
                            CommandParameter="{Binding SelectedPlaylist}">
                        <TextBlock Text="{Binding [PlaylistChangeCover], Source={x:Static loc:Loc.T}}" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Padding="12,6"
                            Command="{Binding DeletePlaylistCommand}"
                            CommandParameter="{Binding SelectedPlaylist}">
                        <TextBlock Text="{Binding [Delete], Source={x:Static loc:Loc.T}}" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="24,0,16,12">
                <ListView Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding SelectedPlaylistTracks}"
                          ItemContainerStyle="{StaticResource TrackRowStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource GridViewHeaderStyle}">
                            <GridViewColumn Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="48" Height="48" CornerRadius="6"
                                                Background="{DynamicResource SecondaryBrush}">
                                            <Grid>
                                                <!-- Нет обложки: серый силуэт мыши -->
                                                <Image Width="24" Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Source="pack://application:,,,/Resources/batlogo_gray.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border CornerRadius="6" controls:LazyCover.Path="{Binding CoverCachePath}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Path=(controls:LazyCover.HasImage), RelativeSource={RelativeSource Self}}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.3"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <ImageBrush Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="380" Header="{Binding [ColTitle], Source={x:Static loc:Loc.T}}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="220" Header="{Binding [ColArtist], Source={x:Static loc:Loc.T}}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayArtist}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="96" Header="{Binding [ColDuration], Source={x:Static loc:Loc.T}}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Duration, Converter={StaticResource TimeStr}}"
                                                   FontFamily="{StaticResource AppFontMono}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding PlayTrackFromPlaylistCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                    </ListView.InputBindings>
                </ListView>
            </Grid>
        </Grid>

        <!-- Пустое состояние: нет ни одного плейлиста. Иконка прижата к ЦЕНТРУ страницы
             (нижний край — за 16px до центра), текст растёт вниз от центра — точка иконки
             та же, что у остальных баров, при переключении задний фон не «прыгает» -->
        <Border Grid.Row="1" Background="Transparent" Margin="24,0,24,12"
                Visibility="{Binding IsDetailView, Converter={StaticResource InvBool2Vis}}"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid Visibility="{Binding Playlists.Count, Converter={StaticResource InvInt2Vis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Path Grid.Row="0" Width="64" Height="64" Stretch="Uniform" Margin="0,0,0,16"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Fill="{DynamicResource TextInactiveBrush}" Data="{StaticResource IconPlaylist}"/>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="{Binding [PlaylistsEmpty], Source={x:Static loc:Loc.T}}"
                               FontSize="20" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding [PlaylistsEmptyHint], Source={x:Static loc:Loc.T}}"
                               FontSize="13" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextInactiveBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
