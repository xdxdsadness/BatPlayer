<Window x:Class="BatPlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BatPlayer.ViewModels"
        xmlns:cv="clr-namespace:BatPlayer.Converters"
        xmlns:controls="clr-namespace:BatPlayer.Controls"
         xmlns:loc="clr-namespace:BatPlayer.Localization"
        Style="{StaticResource MainWindowStyle}"
        Title="Bat Player"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop">

    <Window.Resources>
        <cv:NullToVisibilityConverter x:Key="Null2Vis"/>
        <cv:EmptyToVisibilityConverter x:Key="EmptyToVis"/>
        <cv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <cv:TimeSpanToStringConverter x:Key="TimeStr"/>
        <cv:PathToImageConverter x:Key="Path2Img"/>
        <cv:PlayStateToIconConverter x:Key="PlayIcon"/>
        <cv:RepeatModeToIconConverter x:Key="RepeatIcon"/>
        <cv:VolumeToIconConverter x:Key="VolIcon"/>
        <cv:InverseBoolConverter x:Key="InvBool"/>
        <cv:StringEqualsToVisibilityConverter x:Key="PlatformSource2Vis"/>
        <!-- Vertical volume slider for the popup above the button. Native Slider
             mechanisms only: IsMoveToPointEnabled (track click) + standard thumb drag —
             no SliderDragBehavior (custom mouse capture inside a popup is unreliable).
             IsDirectionReversed stays false: for a vertical Track, false puts the minimum
             at the BOTTOM (fill grows upward, up = louder); true flips it upside down.
             Thumb is a ring: PanelBrush fill hides the track inside the hoop. -->
        <Style x:Key="VolumeVerticalSlider" TargetType="Slider">
            <!-- Must be Vertical: Track takes orientation from the slider property, not
                 from the template — without this setter the Track is horizontal and the
                 slider "does not respond" (thumb is squeezed into 22px horizontally). -->
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    Background="{DynamicResource SecondaryElevatedBrush}"
                                    CornerRadius="2"/>
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Stretch" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <!-- Filled part of the track (visual); clicks pass through
                                         to the Slider (move-to-point). -->
                                    <RepeatButton Focusable="False" IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Width="4"
                                                        Background="{DynamicResource TextPrimaryBrush}"
                                                        CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent" Width="22" Height="22"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="14" Height="14"
                                                             Fill="{DynamicResource PanelBrush}"
                                                             Stroke="{DynamicResource TextPrimaryBrush}"
                                                             StrokeThickness="2"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>   <!-- Title bar -->
                <RowDefinition Height="*"/>    <!-- Body -->
                <RowDefinition Height="80"/>   <!-- Player bar -->
            </Grid.RowDefinitions>

<!-- Window tint: the playing track's cover stretched over the window and heavily
             blurred + darkening — the classic live player background. Colors match the
             cover by definition and photo detail naturally masks banding — no noise,
             no lines. BitmapCache on each layer: content is static between track changes,
             and the crossfade animates the Opacity OF THE LAYER ITSELF (applied at
             composition, cache stays valid). Without the cache ANY window repaint
             (card hover animations, logo spin, wave) recomposited two full-frame images —
             the main CPU multiplier of the whole UI. -->
            <Grid Grid.RowSpan="3" IsHitTestVisible="False">
<Image x:Name="TintImgA" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" CacheMode="BitmapCache"/>
                <Image x:Name="TintImgB" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality" CacheMode="BitmapCache"/>
                <!-- Darkening: content stays readable on any cover -->
                <Border Background="#66101218"/>
            </Grid>


            <!-- ============ Title Bar ============ -->
            <Border Grid.Row="0" Background="Transparent"
                    CornerRadius="12,12,0,0"
                     MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo: tile icon + name (batlogo.png) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0">
                        <Image Width="20" Height="20" Margin="0,0,10,0"
                               Source="pack://application:,,,/Resources/batlogo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="BAT PLAYER" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Search: left edge aligned with the page title column
                         (sidebar 220 + content indent 32 = 252). The field is pinned LEFT
                         with a fixed width: with Stretch, a MaxWidth element centers in the
                         column and "drifts" when switching pages (column width depends on the
                         number of action buttons on the right). MaxWidth bound to the host
                         width — shrinks on narrow windows without hitting those buttons. -->
                    <Grid Grid.Column="1" x:Name="SearchHost" Margin="252,0,16,0" VerticalAlignment="Center">
                                    <Border x:Name="SearchField" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Width="420" MaxWidth="{Binding ActualWidth, ElementName=SearchHost}"
                                            Background="{DynamicResource SecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="14,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform"
                                                  Margin="0,0,10,0" Fill="{DynamicResource TextSecondaryBrush}"
                                                  Data="{StaticResource IconSearch}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding [Search], Source={x:Static loc:Loc.T}}" FontSize="12"
                                                       Foreground="{DynamicResource TextInactiveBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}"/>
                                            <!-- Negative left margin cancels the TextBox template's
                                                 inner Margin=1 (Aero2): otherwise the caret overlaps
                                                 the first letter of the "S…" placeholder in the same column -->
                                            <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0"
                                                     Margin="-2,0,0,0"
                                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                                     CaretBrush="{DynamicResource AccentBrush}"
                                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                     HorizontalContentAlignment="Left"
                                                     FontSize="12" MinWidth="180"
                                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="SearchBox_KeyDown"/>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                    Width="22" Height="22"
                                                    Click="SearchClear_Click"
                                                    Visibility="{Binding SearchText, Converter={StaticResource Null2Vis}}"
                                                    ToolTip="{Binding [ClearSearch], Source={x:Static loc:Loc.T}}">
                                <Path Width="12" Height="12" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource IconClose}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>

                    <!-- Top action buttons -->
                    <!-- Card grid density: 4 or 8 columns (CompactGrid) -->
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Margin="0,0,4,0"
                            Command="{Binding ToggleGridColumnsCommand}"
                            ToolTip="{Binding [ToggleGridDensity], Source={x:Static loc:Loc.T}}">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                              <Path.Data>
                                <PathGeometry Figures="M0 0h2.2v2.2H0zM3.26 0h2.2v2.2H3.26zM6.53 0h2.2v2.2H6.53zM9.8 0h2.2v2.2H9.8zM0 3.26h2.2v2.2H0zM3.26 3.26h2.2v2.2H3.26zM6.53 3.26h2.2v2.2H6.53zM9.8 3.26h2.2v2.2H9.8z"/>
                              </Path.Data>
                        </Path>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Margin="0,0,4,0"
                            Command="{Binding AddFilesCommand}" ToolTip="{Binding [AddFiles], Source={x:Static loc:Loc.T}}">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="{StaticResource IconFile}"/>
                    </Button>
                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Margin="0,0,4,0"
                            Command="{Binding AddFolderCommand}" ToolTip="{Binding [AddFolder], Source={x:Static loc:Loc.T}}">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="{StaticResource IconFolder}"/>
                    </Button>
                    <StackPanel Grid.Column="2" x:Name="PageActionsHost" Orientation="Horizontal" Margin="8,0,12,0"
                                VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"/>
                    <Button Grid.Column="6" Style="{StaticResource IconButton}" Margin="0,0,4,0"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings"
                            ToolTip="{Binding [Settings], Source={x:Static loc:Loc.T}}">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="{StaticResource IconSettings}"/>
                    </Button>

                    <!-- Window controls: 12px gap from app actions, 4px between, 8px to edge -->
                    <Button Grid.Column="7" x:Name="BtnMin" Style="{StaticResource IconButton}"
                            Margin="12,0,4,0"
                            Click="BtnMin_Click" ToolTip="{Binding [Minimize], Source={x:Static loc:Loc.T}}">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="{StaticResource IconMinimize}"/>
                    </Button>
                    <Button Grid.Column="8" x:Name="BtnClose" Style="{StaticResource IconButton}"
                            Margin="0,0,8,0"
                            Click="BtnClose_Click" ToolTip="{Binding [Close], Source={x:Static loc:Loc.T}}">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="{StaticResource IconClose}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ Body: sidebar + content ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" x:Name="SidebarCol"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Sidebar ===== -->
                <Border Grid.Column="0" Background="Transparent"
                        BorderThickness="0">
                    <Grid>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" Padding="12,14,12,8"
                                      controls:SmoothScroll.Enabled="False">
                            <StackPanel>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                             IsChecked="True" Content="{Binding [Home], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Home"
                                             Tag="{StaticResource IconHome}"/>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                             Content="{Binding [WaveNav], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Wave"
                                             Tag="{StaticResource IconSparkle}"/>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                             Content="{Binding [Playlists], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Playlists"
                                             Tag="{StaticResource IconPlaylist}"/>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                             Content="{Binding [RecentlyPlayed], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="RecentlyPlayed"
                                             Tag="{StaticResource IconHistory}"/>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                             Content="{Binding [Favorites], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Favorites"
                                             Tag="{StaticResource IconFavorite}"/>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                             Content="{Binding [Artists], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Artists"
                                             Tag="{StaticResource IconArtist}"/>
                                <!-- Platform items: monochrome vector logos
                                     (NavButtonLogo, 30px) — larger than regular icons, themed;
                                     SoundCloud uses the full logo with bars -->
                                <RadioButton Style="{StaticResource NavButtonLogo}" GroupName="Nav"
                                             Content="{Binding [SoundCloud], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="SoundCloud"
                                             Tag="{StaticResource IconSoundCloudLogo}"/>
                                <RadioButton Style="{StaticResource NavButtonLogo}" GroupName="Nav"
                                             Content="Spotify"
                                             Command="{Binding NavigateCommand}" CommandParameter="Spotify"
                                             Tag="{StaticResource IconSpotifyGlyph}"/>
                                <RadioButton Style="{StaticResource NavButtonLogo}" GroupName="Nav"
                                             Content="{Binding [YandexMusic], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="YandexMusic"
                                             Tag="{StaticResource IconYandexMusicGlyph}"/>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                             Content="{Binding [Downloads], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Downloads"
                                             Tag="{StaticResource IconDownload}"/>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                             Content="{Binding [StatsTitle], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Statistics"
                                             Tag="{StaticResource IconStats}"/>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                             Content="{Binding [Equalizer], Source={x:Static loc:Loc.T}}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Equalizer"
                                             Tag="{StaticResource IconEqualizer}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ===== Content host (rounded clip applied in code-behind) ===== -->
                <!-- Background stays transparent: RootBorder paints the base and the ambient
                     layer sits above it — an opaque background here would hide the glow
                     in the track area -->
                <Grid Grid.Column="1" x:Name="ContentHost" Background="Transparent">
                    <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}"/>

                </Grid>
            </Grid>



            <!-- ============ Player Bar ============ -->
            <!-- The separator = the bar's top border (y=720): cards clip exactly at it
                 (ContentHost ends at the row boundary), the avatar is centered in the 80px
                 row → 8px above and below. Measured: a line at 722.5 left 4.5px above the
                 avatar vs 9px below — "more below than above". -->
            <Border Grid.Row="2" Background="Transparent"
                    CornerRadius="0,0,12,12"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cover on the left (SoundCloud-like). Hover: slight grow —
                         the same lively reaction as buttons and cards -->
                    <Grid Grid.Column="0" Width="64" Height="64" VerticalAlignment="Center" Margin="0,0,12,0"
                          Background="Transparent" Cursor="Hand" MouseLeftButtonUp="BarCover_Click"
                          RenderTransformOrigin="0.5,0.5"
                          ToolTip="{Binding [OpenCover], Source={x:Static loc:Loc.T}}">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <!-- Explicit From="1": re-hovering always replays the scale
                                         (hold-end clocks cannot be overridden by a Setter —
                                         property-path is not allowed in Style.Setter) -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     From="1" To="1.05" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     From="1" To="1.05" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     To="1" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     To="1" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- ImageBrush center-crops the artwork to a 1:1 square -->
                        <Border CornerRadius="8" Background="{DynamicResource SecondaryBrush}">
                            <!-- No cover: gray bat silhouette marks an inactive track
                                 (same #6F6F6F as the old disc) -->
                            <Image Width="40" Stretch="Uniform" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Source="pack://application:,,,/Resources/batlogo_gray.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <!-- Two cover layers: the crossfade on track change is driven by
                             code-behind (the old cover dissolves under the new one, no hard
                             swap). Layers are transparent — the bat placeholder shows through. -->
                        <Border x:Name="BarCoverLayerA" CornerRadius="8" Opacity="0" IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border x:Name="BarCoverLayerB" CornerRadius="8" Opacity="0" IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Title / artist: ellipsized when too long;
                         platform badge hugs the title (MaxWidth from code-behind) -->
                    <StackPanel x:Name="PlayerTextHost" Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" ClipToBounds="True">
                            <TextBlock x:Name="PlayerTitleText" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Player.CurrentTrack.DisplayTitle}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Player.CurrentTrack}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{Binding [NoTrack], Source={x:Static loc:Loc.T}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Platform badge after the title (local files have none).
                                 FallbackValue=Collapsed is required: when CurrentTrack=null
                                 the path CurrentTrack.Source does not resolve, and without the
                                 fallback the badge stayed Visible — all three logos glowed on
                                 "No track". -->
                            <Image Width="18" Height="18" Stretch="Uniform" Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Source="{StaticResource SoundCloudLogoSmall}"
                                   Visibility="{Binding Player.CurrentTrack.Source, FallbackValue=Collapsed, Converter={StaticResource PlatformSource2Vis}, ConverterParameter=soundcloud}" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image Width="18" Height="18" Stretch="Uniform" Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Source="{StaticResource SpotifyGlyphGreen}"
                                   Visibility="{Binding Player.CurrentTrack.Source, FallbackValue=Collapsed, Converter={StaticResource PlatformSource2Vis}, ConverterParameter=spotify}" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image Width="18" Height="18" Stretch="Uniform" Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Source="{StaticResource YandexMusicGlyphYellow}"
                                   Visibility="{Binding Player.CurrentTrack.Source, FallbackValue=Collapsed, Converter={StaticResource PlatformSource2Vis}, ConverterParameter=yandex}" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </StackPanel>
                        <TextBlock x:Name="PlayerArtistText" Text="{Binding Player.CurrentTrack.DisplayArtist, FallbackValue='—'}"
                                   FontSize="12" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Favorite -->
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="0,0,12,0"
                            Command="{Binding Player.ToggleFavoriteCommand}"
                            ToolTip="{Binding [Favorite], Source={x:Static loc:Loc.T}}">
                        <Path x:Name="FavIcon" Width="16" Height="16" Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform/>
                            </Path.RenderTransform>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconFavoriteOutline}"/>
                                    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Player.IsFavorite}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource FavoriteBrush}"/>
                                            <Setter Property="Data" Value="{StaticResource IconFavorite}"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     From="0.5" To="1" Duration="0:0:0.4">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase Amplitude="3" EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     From="0.5" To="1" Duration="0:0:0.4">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase Amplitude="3" EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- Transport in one row: prev / play / next + shuffle / repeat (SoundCloud) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Margin="0,0,8,0"
                                Command="{Binding Player.PreviousCommand}" ToolTip="{Binding [Previous], Source={x:Static loc:Loc.T}}">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource IconPrev}"/>
                        </Button>
                        <Button Style="{StaticResource PlayIconButton}" Margin="0,0,8,0"
                                Command="{Binding Player.PlayPauseCommand}" ToolTip="{Binding [PlayPause], Source={x:Static loc:Loc.T}}">
                            <!-- Logo instead of a pause icon: spins while playing; on pause it
                                 coasts and freezes at the current angle. Rotation is driven by a
                                 standard DoubleAnimation (RepeatBehavior=Forever) from code-behind —
                                 no custom per-frame render code. BitmapCache: the logo is drawn
                                 into a texture once; spin frames are cheap cache transforms,
                                 not redraws. -->
                            <Image Width="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Source="pack://application:,,,/Resources/batlogo_dark.png"
                                   RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality"
                                   CacheMode="BitmapCache">
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="BatSpinAngle" Angle="0"/>
                                </Image.RenderTransform>
                            </Image>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="0,0,20,0"
                                Command="{Binding Player.NextCommand}" ToolTip="{Binding [Next], Source={x:Static loc:Loc.T}}">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="{StaticResource IconNext}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="0,0,8,0"
                                Command="{Binding Player.ToggleShuffleCommand}"
                                ToolTip="{Binding [Shuffle], Source={x:Static loc:Loc.T}}">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="{StaticResource IconShuffle}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Player.IsShuffle}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding Player.CycleRepeatCommand}"
                                ToolTip="{Binding [Repeat], Source={x:Static loc:Loc.T}}">
                            <Path Width="16" Height="16" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconRepeat}"/>
                                        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Player.RepeatMode}" Value="RepeatAll">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Player.RepeatMode}" Value="RepeatOne">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Data" Value="{StaticResource IconRepeatOne}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </StackPanel>

                    <!-- Timeline -->
                    <Grid Grid.Column="4" Margin="16,0,8,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Player.Position, Converter={StaticResource TimeStr}}"
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,8,0" FontFamily="{StaticResource AppFontMono}"/>
                        <controls:WaveformTimeline Grid.Column="1" Height="40" VerticalAlignment="Center"
                                PeaksSource="{Binding Player.CurrentTrack.FilePath, Mode=OneWay}"
                                PositionSeconds="{Binding Player.Position.TotalSeconds, Mode=OneWay}"
                                DurationSeconds="{Binding Player.Duration.TotalSeconds, Mode=OneWay}"
                                SeekCommand="{Binding Player.SeekToCommand}"
                                PlayedBrush="{DynamicResource AccentBrush}"
                                UnplayedBrush="{DynamicResource BorderLightBrush}"
                                PlayheadBrush="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Player.Duration, Converter={StaticResource TimeStr}}"
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="8,0,0,0" FontFamily="{StaticResource AppFontMono}"/>
                    </Grid>

                    <!-- Right edge: volume (slides out on hover) + extended player -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Volume: button; the slider panel lives at the window root —
                             guaranteed z-order above content, clipped by nothing.
                             Hover open/close is handled by code-behind. -->
                        <Button x:Name="VolumeButton" Style="{StaticResource IconButton}"
                                    Command="{Binding Player.ToggleMuteCommand}"
                                    MouseEnter="VolumeButton_MouseEnter"
                                    MouseLeave="VolumeButton_MouseLeave">
                                <Path Width="16" Height="16" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource IconVolumeHigh}"/>
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Player.IsMuted}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                                    <Setter Property="Data" Value="{StaticResource IconVolumeMute}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>

                        <!-- "Add to playlist": adds the currently playing track -->
                        <Button Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                Click="AddToPlaylistFromPlayer_Click"
                                ToolTip="{Binding [AddToPlaylist], Source={x:Static loc:Loc.T}}">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M10.5,3h3v7.5H21v3h-7.5V21h-3v-7.5H3v-3h7.5z"/>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Volume panel at the window ROOT level: guaranteed z-order above all pages
                 and the bar (inside the bar's subtree its top was clipped by the bar edge).
                 Anchored above the volume button: right = bar padding 16 + "+" 30 + gap 8
                 + half-button 15 - half-panel 20 = 49; panel bottom ~6px above the button:
                 button is centered in the 80px bar → its bottom is 25px from the bar bottom,
                 plus a 6px gap = 61.
                 RowSpan=3 IS REQUIRED: in the row-2 cell (80px) with bottom margin 61 the
                 grids give the panel an 80-61=19px slot — the explicit Height=150 is ignored,
                 the panel collapses to content height (~25px) and looks "cut off".
                 Spanning all rows gives a full-window slot — Height=150 is honored. -->
            <Border Grid.RowSpan="3" x:Name="VolumePopupPanel" Width="40" Height="150" Margin="0,0,49,61"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    Background="{DynamicResource SecondaryBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                    CornerRadius="10" RenderTransformOrigin="0.5,1"
                    MouseEnter="VolumePopup_MouseEnter"
                    MouseLeave="VolumePopup_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="VolumePopupSlide" Y="0"/>
                </Border.RenderTransform>
                <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeVerticalSlider}"
                        HorizontalAlignment="Center" VerticalAlignment="Stretch"
                        Margin="0,10"
                        Minimum="0" Maximum="100"
                        Value="{Binding Player.Volume, Mode=TwoWay}"
                        LostMouseCapture="VolumeSlider_LostMouseCapture"/>
            </Border>
<!-- Cover viewer: click the avatar in the player bar (clicking the avatar again
                 or clicking anywhere closes it; no close button anymore).
                 Background is a neutral translucent veil with no hue (the window is
                 dimmed, not tinted); the cover is shown large, without a shadow. -->
            <Grid Grid.RowSpan="3" Panel.ZIndex="100" x:Name="CoverViewerHost" Visibility="Collapsed" Focusable="False">
                <Border x:Name="CoverViewerBlur" Background="#96101218"/>
                <Image x:Name="CoverViewerImage" Stretch="Uniform" Opacity="0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="760" MaxHeight="760" Margin="56"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Grid>
    </Border>
</Window>
