<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:BatPlayer.Controls"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <Style TargetType="{x:Type ctrl:CustomSlider}">
        <Setter Property="Background" Value="{DynamicResource SecondaryElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:CustomSlider}">
                    <Grid VerticalAlignment="Center">
                        <Border Height="{TemplateBinding TrackHeight}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                        <!-- RepeatButtons (LargeChange clicks) removed: they intercepted the mouse,
                             broke drag seeking via DragBehavior and are not needed for a seek bar.
                             Track clicks are handled by the Slider itself (IsMoveToPointEnabled). -->
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <!-- Filled part of the track (visual only). IsHitTestVisible=false:
                                     clicks pass through to the Slider (move-to-point). -->
                                <primitives:RepeatButton Focusable="False" IsHitTestVisible="False">
                                    <primitives:RepeatButton.Template>
                                        <ControlTemplate TargetType="primitives:RepeatButton">
                                            <Border Height="{TemplateBinding TrackHeight, RelativeSource={RelativeSource AncestorType=ctrl:CustomSlider}}"
                                                    Background="{TemplateBinding Foreground, RelativeSource={RelativeSource AncestorType=ctrl:CustomSlider}}"
                                                    CornerRadius="{TemplateBinding CornerRadius, RelativeSource={RelativeSource AncestorType=ctrl:CustomSlider}}"/>
                                        </ControlTemplate>
                                    </primitives:RepeatButton.Template>
                                </primitives:RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <primitives:Thumb>
                                    <primitives:Thumb.Template>
                                        <ControlTemplate TargetType="primitives:Thumb">
                                            <Ellipse x:Name="ThumbEllipse"
                                                     Width="{TemplateBinding ThumbSize, RelativeSource={RelativeSource AncestorType=ctrl:CustomSlider}}"
                                                     Height="{TemplateBinding ThumbSize, RelativeSource={RelativeSource AncestorType=ctrl:CustomSlider}}"
                                                     Fill="{DynamicResource TextPrimaryBrush}"
                                                     Stroke="{DynamicResource PanelBrush}" StrokeThickness="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbEllipse" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </primitives:Thumb.Template>
                                </primitives:Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
