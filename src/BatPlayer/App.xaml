<Application x:Class="BatPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BatPlayer.ViewModels"
             xmlns:v="clr-namespace:BatPlayer.Views"
            >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Icons must come BEFORE DarkTheme: templates in the theme reference
                     icons via StaticResource, which only sees earlier dictionaries. -->
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Fonts.xaml"/>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="Controls/CircleButton.xaml"/>
                <ResourceDictionary Source="Controls/CustomSlider.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- View-ViewModel mappings -->
            <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
                <v:LibraryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ArtistsViewModel}">
                <v:ArtistsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ArtistProfileViewModel}">
                <v:ArtistProfileView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <v:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EqualizerViewModel}">
                <v:EqualizerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaylistViewModel}">
                <v:PlaylistView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SoundCloudLikesViewModel}">
                <v:SoundCloudLikesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SpotifyMusicViewModel}">
                <v:SpotifyMusicView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VkMusicViewModel}">
                <v:VkMusicView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:YmMusicViewModel}">
                <v:YmMusicView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WaveViewModel}">
                <v:WaveView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
                <v:DownloadsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatsViewModel}">
                <v:StatsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
