<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Surface palette — тона логотипа: графитово-сланцевый квадрат (#20242A)
         со светлой окантовкой (#595E64) и белой мышью. Раньше был нейтральный чёрный
         (#121212/#181818), из-за чего интерфейс не совпадал с логотипом ===== -->
    <Color x:Key="BgColor">#1A1D22</Color>
    <Color x:Key="PanelColor">#20242A</Color>
    <Color x:Key="PanelElevatedColor">#24282E</Color>
    <Color x:Key="SecondaryColor">#2A2F36</Color>
    <Color x:Key="SecondaryElevatedColor">#333941</Color>
    <Color x:Key="BorderColor">#3A4048</Color>
    <Color x:Key="BorderLightColor">#4A515A</Color>

    <!-- ===== Text ===== -->
    <Color x:Key="TextPrimaryColor">#F1F2F4</Color>
    <Color x:Key="TextSecondaryColor">#A2A8B0</Color>
    <Color x:Key="TextInactiveColor">#6E757E</Color>

    <!-- ===== Accents ===== -->
    <Color x:Key="AccentColor">#EDEEF0</Color>
    <Color x:Key="AccentDimColor">#8A9098</Color>
    <Color x:Key="HoverColor">#3E454D</Color>
    <Color x:Key="PressedColor">#262B31</Color>
    <Color x:Key="SelectedColor">#343B43</Color>
    <Color x:Key="FocusColor">#5A626B</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="BgBrush"             Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush"          Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelElevatedBrush"  Color="{StaticResource PanelElevatedColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush"      Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryElevatedBrush" Color="{StaticResource SecondaryElevatedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush"    Color="{StaticResource BorderLightColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextInactiveBrush"   Color="{StaticResource TextInactiveColor}"/>

    <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDimBrush"      Color="{StaticResource AccentDimColor}"/>
    <SolidColorBrush x:Key="HoverBrush"          Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="PressedBrush"        Color="{StaticResource PressedColor}"/>
    <SolidColorBrush x:Key="SelectedBrush"       Color="{StaticResource SelectedColor}"/>
    <SolidColorBrush x:Key="FocusBrush"          Color="{StaticResource FocusColor}"/>

    <SolidColorBrush x:Key="FavoriteBrush"       Color="#E5C07B"/>
    <SolidColorBrush x:Key="ErrorBrush"          Color="#E05555"/>

    <!-- ===== Geometry ===== -->
    <CornerRadius x:Key="CornerSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerLarge">12</CornerRadius>
    <CornerRadius x:Key="CornerRound">999</CornerRadius>

    <Thickness x:Key="MarginTiny">4</Thickness>
    <Thickness x:Key="MarginSmall">8</Thickness>
    <Thickness x:Key="MarginMedium">12</Thickness>
    <Thickness x:Key="MarginLarge">16</Thickness>
    <Thickness x:Key="MarginXLarge">24</Thickness>

    <Thickness x:Key="PadTiny">3</Thickness>
    <Thickness x:Key="PadSmall">6</Thickness>
    <Thickness x:Key="PadMedium">10</Thickness>
    <Thickness x:Key="PadLarge">16</Thickness>

    <Duration x:Key="AnimDuration">0:0:0.15</Duration>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource BgColor}"/>
    <DropShadowEffect x:Key="CardCoverShadow" BlurRadius="12" ShadowDepth="3" Direction="270"
                      Opacity="0.32" Color="#000000" RenderingBias="Performance"/>
</ResourceDictionary>
